{
  "schemaVersion": 1,
  "id": "voicecast",
  "version": "${version}",
  "name": "VoiceCast",
  "description": "Offline phonetic speech recognition library for Minecraft mods.",
  "authors": ["theo"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.theo.voicecast.fabric.VoiceCastFabric"],
    "client": ["com.theo.voicecast.fabric.VoiceCastFabricClient"],
    "modmenu": ["com.theo.voicecast.fabric.VoiceCastModMenu"]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "voicechat": "*",
    "plasmo_voice": "*"
  },
  "custom": {
    "modmenu": {
      "badges": ["library"]
    }
  }
}
